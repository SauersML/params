{
  "layout": "elk",
  "elk": {
    "mergeEdges": false,
    "nodePlacementStrategy": "NETWORK_SIMPLEX"
  },
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Inter, 'Helvetica Neue', 'DejaVu Sans', Arial, sans-serif",
    "fontSize": "18px",
    "primaryColor": "#ffffff",
    "primaryTextColor": "#172f52",
    "primaryBorderColor": "#8b96a8",
    "lineColor": "#75869f",
    "clusterBkg": "#fafbfe",
    "clusterBorder": "#dbe2ed",
    "edgeLabelBackground": "#ffffff"
  },
  "flowchart": {
    "htmlLabels": true,
    "curve": "basis",
    "nodeSpacing": 30,
    "rankSpacing": 42,
    "padding": 18,
    "wrappingWidth": 440,
    "useMaxWidth": false
  }
}
